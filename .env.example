PORT=4000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
FRONTEND_URL=https://your-app.vercel.app

# --- Offer messages (optional; see README "Offer messages") ---
# Set to true to log offer messages instead of sending them (testing).
MESSAGING_DRY_RUN=false
# WhatsApp Cloud API (Meta). Template body: "Hi {{1}}, {{2}} has a special offer for you: {{3}}"
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v23.0
# MSG91 SMS (DLT-registered template using ##name## ##store## ##offer##)
MSG91_AUTH_KEY=
MSG91_SMS_TEMPLATE_ID=
SMS_OFFER_MAX_CHARS=30
# Free demo size and your per-message cost incl. GST (for the admin's estimate)
OFFER_DEMO_MAX_RECIPIENTS=50
OFFER_COST_WHATSAPP=1.02
OFFER_COST_SMS=0.20
